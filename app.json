{
  "expo": {
    "name": "showmi",
    "slug": "showmi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/showmi-icon.png",
    "scheme": "showmi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/showmi-logo.icon",
      "bundleIdentifier": "com.showmi.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#942192",
        "foregroundImage": "./assets/images/showmi-android-foreground.png",
        "backgroundImage": "./assets/images/showmi-android-background.png",
        "monochromeImage": "./assets/images/showmi-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.showmi.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/showmi-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#942192",
          "image": "./assets/images/showmi-splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/with-ios-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
